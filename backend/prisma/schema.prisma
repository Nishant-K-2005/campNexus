// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]

}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  Student
  Professor
  ClubHead
  Admin
}

model User {
  user_id String @id @default(uuid())
  email String @unique
  pass_hash String
  full_name String
  role Role
  created_at DateTime @default(now())
  deleted_at DateTime?
  purge_at DateTime?

  // Relationships
  profile Profile?
  created_communities Community[] @relation("community_creator")
  community_member CommunityMember[]
  posts Post[]
  submitted_reports FlagReport[]
  replies Reply[]
}

model Profile {
  profile_id String @id @default(uuid())
  user_id String @unique
  bio String?
  interested_tags String[]
  reputation_points Int @default(0)
  tags_vector Unsupported("vector(384)")?
  open_to_mentoring Boolean @default(false)
  portfolio_link String?

  // Relationships
  user User @relation(fields: [user_id],references: [user_id], onDelete:Cascade)
}

model Community {
  community_id String @id @default(uuid())
  name String
  description String?
  tags String[]
  embedding_vector Unsupported("vector(384)")?
  created_by_user_id String
  deleted_at DateTime?
  purge_at DateTime?

  // Relationships
  created_by_user User @relation("community_creator",fields: [created_by_user_id],references: [user_id], onDelete:Cascade)
  members CommunityMember[]
  posts Post[]
}

enum CommunityMemberRole{
  Member
  Moderator
}

model CommunityMember {
  user_id String
  community_id String
  @@id([user_id,community_id])
  role CommunityMemberRole @default(Member)
  joined_at DateTime @default(now())
  left_at DateTime?

  // Relationships
  user User @relation(fields: [user_id],references: [user_id], onDelete:Cascade)
  community Community @relation(fields: [community_id], references: [community_id], onDelete: Cascade)
}

enum PostType{
  Discussion
  Resource
  Announcement
}

enum PostStatus{
  Pending
  Accepted
  Rejected
  Flagged
}

model Post{
  post_id String @id @default(uuid())
  user_id String
  community_id String
  content String
  type PostType
  status PostStatus @default(Pending)
  embedding_vector Unsupported("vector(384)")?
  created_at DateTime @default(now())
  deleted_at DateTime?
  purge_at DateTime?

  // relationship
  user User @relation(fields: [user_id],references: [user_id], onDelete: Cascade)
  community Community @relation(fields: [community_id],references: [community_id], onDelete: Cascade)
  attachments PostAttachment[]
  replies Reply[]
  llm_audit_logs LLMAuditLog[]
  flag_reports FlagReport[]
}

enum AttachmentType{
  Doc
  Image
  Link
}

model PostAttachment{
  attachment_id String @id @default(uuid())
  post_id String
  type AttachmentType
  url String
  title String
  file_size String?
  isVerified Boolean @default(false)

  // relationships
  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
}

enum Decision{
  Accepted
  Rejected
  Flagged
}

model Reply{
  reply_id String @id @default(uuid())
  post_id String
  user_id String
  content String
  depth Int @default(0)
  created_at DateTime @default(now())
  parent_id String?
  deleted_at DateTime?
  purge_at DateTime?

  // relationship
  post Post @relation(fields: [post_id], references: [post_id], onDelete:Cascade)
  user User @relation (fields: [user_id], references: [user_id], onDelete:Cascade)
  parent Reply? @relation("ReplyTree",fields: [parent_id], references: [reply_id], onDelete: Cascade)
  replies Reply[] @relation("ReplyTree")

}

model LLMAuditLog{
  log_id String @id @default(uuid())
  post_id String
  decision Decision
  reason String?
  confidenceScore Float
  processed_at DateTime @default(now())

  // relationship
  post Post @relation(fields: [post_id],references: [post_id], onDelete:Cascade)
}

enum FlagStatus{
  Open
  Resolved
  Dismissed
}

model FlagReport{
  report_id String @id @default(uuid())
  post_id String
  reporter_user_id String
  reason String
  status FlagStatus @default(Open)

  // relationship
  post Post @relation(fields: [post_id],references: [post_id], onDelete:Cascade)
  reporter User @relation(fields: [reporter_user_id],references: [user_id], onDelete:Cascade)
}
